@page "/"

<PageTitle>Ariel Mariussi — Developer .NET Fullstack</PageTitle>

<!-- ── HERO ── -->
<section class="hero">
    <div class="site-wrapper">
        <p class="hero-label fade-in">Developer .NET Fullstack</p>
        <h1 class="hero-name fade-in delay-1">
            Ariel<br /><span>Mariussi</span>
        </h1>
        <p class="hero-role fade-in delay-2">// C# · .NET · Blazor · REST APIs</p>
        <p class="hero-desc fade-in delay-3">
            Full-stack developer specializing in <strong>.NET</strong>and <strong>C#</strong>.
            I build robust APIs, modern interfaces with Blazor, and end-to-end solutions
            from the database to the UI.
        </p>
        <div class="hero-cta fade-in delay-4">
            <a href="#projetos" class="btn btn-primary"> Projetcs →</a>
            <a href="#contato" class="btn btn-secondary"></a>
        </div>
    </div>
</section>

<!-- ── STACK ── -->
<section class="stack-section" id="stack">
    <div class="site-wrapper">
        <p class="section-label">Tech stach</p>
        <div class="stack-grid">
            @foreach (var item in _stack)
            {
                <div class="stack-item">
                    <div class="stack-dot"></div>
                    <div class="stack-item-cat">@item.Category</div>
                    <div class="stack-item-name">@item.Name</div>
                </div>
            }
        </div>
    </div>
</section>

<!-- ── PROJETOS ── -->
<section class="projects-section" id="projetos">
    <div class="site-wrapper">
        <p class="section-label">Projects</p>

        <div class="project-card">
            <div class="project-header">
                <span class="project-number">01 / 01</span>
                <div class="project-tags">
                    <span class="tag tag-highlight">Em produção</span>
                    <span class="tag">Fullstack</span>
                </div>
            </div>
            <div class="project-body">
                <h1 class="project-title-heading">EmprestimoLivros(BookLoan)</h1>
                <p class="project-desc">
                    <span class="project-title">About:</span>EmprestimoLivros(BookLoan) is a
                    web application that provides complete control over book loans. Each user
                    can create, edit, delete, and view their own loans, with an authentication
                    system and data isolation.
                    <br />
                    <span class="project-title">Tecnologies:</span>
                    <ul>
                        <li>ASP.NET Core 9 MVC (web framework)</li>
                        <li>Entity Framework Core 9 (ORM)</li>
                        <li>ASP.NET Identity (authentication and authorization)</li>
                        <li>PostgreSQL/Neon (cloud database)</li>
                        <li>Bootstrap 5 (UI)</li>
                        <li>Docker (containerization)</li>
                        <li>Render (hosting with automatic CI/CD)</li>
                        <li>GitHub (version control)</li>
                    </ul>
                    <br />
                    <br />
                    <span class="project-title">Want to know more?</span> For more details, check out the project's README on GitHub:<a href="https://github.com/ArielMariussi" target="_blank" class="btn btn-secondary">
                    GitHub →
                </a>
                <a href="https://emprestimolivros-9csn.onrender.com/" target="_blank" class="btn btn-primary">
                    Website →
                </a>
            </p>
            <br />
            <br />
            <h1 class="project-title project-title-heading">MedReminder</h1>
            <p class="project-desc">
                <span class="project-title">Sobre:</span>MedReminder is a web application that provides complete control over continuous or temporary medications by alerting you when
                it's time to take your medicine with a sound alert and a
                notification (if you're using Google Chrome, check that notifications aren't blocked by the operating system).
                Each user can register their medications, set dosing times,
                mark doses as taken, and track their treatment adherence history, with an
                authentication system and data isolation.
                <br />
                The project is split into two parts: an ASP.NET Core 9 Web API that exposes the endpoints and handles persistence,
                and a Blazor WebAssembly frontend that consumes the API and runs entirely in the browser.
                <br />
                <span class="project-title">Tecnologias:</span>
                <ul>
                    <li>ASP.NET Core 9 Web API (backend and REST/Minimal API endpoints)</li>
                    <li>Blazor WebAssembly (SPA frontend running in the browser)</li>
                    <li>Entity Framework Core 9 (ORM)</li>
                    <li>ASP.NET Identity (authentication and authorization)</li>
                    <li>PostgreSQL/Neon (cloud database)</li>
                    <li>Docker (backend containerization)</li>
                    <li>GitHub Actions (CI/CD with automated build and deploy)</li>
                    <li>Render (Web API hosting)</li>
                    <li>Vercel (Blazor WASM frontend hosting)</li>
                    <li>GitHub (version control)</li>
                </ul>
                <br />
                <br />
                <br />
                <span class="project-title">Want to know more?</span> For more details, checkout the project's README on Github:
                <div class="project-links">
                    <a href="https://github.com/ArielMariussi" target="_blank" class="btn btn-secondary">
                        GitHub →
                    </a>
                    <a href="https://med-lembrete-de-remedios.vercel.app/login" target="_blank" class="btn btn-primary">
                        Website →
                    </a>
                    <a href="https://med-lembretederemedios.onrender.com/swagger/index.html" target="_blank" class="btn btn-primary">
                        Live API →
                    </a>
                </div>

            </p>
            <div class="project-stack">
                @foreach (var tech in _medTechs)
                {
                    <span class="stack-badge">@tech</span>
                }
            </div>

        </div>
    </div>

</div>
</section>

<!-- ── CONTATO ── -->
<section class="contact-section" id="contato">
    <div class="site-wrapper">
        <p class="section-label">Contact</p>
        <h2 style="font-family: var(--font-display); font-size: clamp(28px, 5vw, 48px); font-weight: 800; letter-spacing: -1px; margin-bottom: 12px;">
            Vamos conversar?
        </h2>
        <p style="color: var(--muted); font-size: 14px; max-width: 400px;">
            Aberto a oportunidades e colaborações em projetos .NET.
        </p>

        <div class="contact-grid">
            <div class="contact-item">
                <span class="contact-label">Email</span>
                <a href="mailto:arielmariussi@gmail.com">arielmariussi@gmail.com</a>
            </div>
            <div class="contact-item">
                <span class="contact-label">LinkedIn</span>
                <a href="https://www.linkedin.com/in/ariel-mariussi-dev" target="_blank">linkedin.com/in/ariel-mariussi-dev</a>
            </div>
            <div class="contact-item">
                <span class="contact-label">GitHub</span>
                <a href="https://github.com/ArielMariussi" target="_blank">github.com/ArielMariussi</a>
            </div>
            <div class="contact-item">
                <span class="contact-label">Localization</span>
                <span style="color: var(--muted);"> Curitiba - Brasil 🇧🇷</span>
            </div>
        </div>
    </div>
</section>

@code {
    private record StackItem(string Category, string Name);

    private readonly List<StackItem> _stack = new()
    {
        new("Backend",   "C# / .NET"),
        new("Backend",   "ASP.NET Core"),
        new("Backend",   "REST APIs"),
        new("Frontend",  "Blazor WASM"),
        new("Banco",     "PostgreSQL"),
        new("Banco",     "Neon (serverless)"),
        new("Cloud",     "Render"),
        new("Cloud",     "Vercel"),
        new("Versionamento", "Git / GitHub"),
    };

    private readonly List<string> _medTechs = new()
    {
        "C#", ".NET", "ASP.NET Core", "PostgreSQL", "Neon", "Render", "REST API", "Entity Framework"
    };
}
